<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Ta Na Escola</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>ta_na_escola</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	
	<!-- 1. PERMISSÃO DE CÂMERA (OBRIGATÓRIA para seu erro atual) -->
	<key>NSCameraUsageDescription</key>
	<string>O Ta Na Escola usa a câmera para cadastrar o rosto dos pais e responsáveis, permitindo acesso seguro e automatizado durante reuniões escolares. As imagens são usadas exclusivamente para reconhecimento facial na portaria da escola.</string>
	
	<!-- 2. PERMISSÃO DE GALERIA (para mlkit_face_detection) -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>O Ta Na Escola precisa acessar suas fotos para permitir que você selecione uma imagem para o cadastro facial ou foto de perfil. Suas fotos não são compartilhadas com terceiros.</string>
	
	<!-- 3. PERMISSÃO DE NOTIFICAÇÕES (para firebase_messaging) -->
	<key>NSUserNotificationUsageDescription</key>
	<string>O Ta Na Escola envia notificações para alertar sobre a chegada e saída dos seus filhos da escola, garantindo que você esteja sempre informado sobre a segurança deles.</string>
	
	<!-- 4. CONFIGURAÇÃO PARA NOTIFICAÇÕES EM SEGUNDO PLANO -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	
	<!-- 5. SCHEMES PARA ABRIR LINKS EXTERNOS (para url_launcher) -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>https</string>
		<string>http</string>
		<string>tel</string>
		<string>sms</string>
		<string>mailto</string>
	</array>
	
	<!-- 6. CONFIGURAÇÃO FIREBASE -->
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
	
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	
	<!-- 7. ORIENTAÇÕES SUPORTADAS -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	
</dict>
</plist>