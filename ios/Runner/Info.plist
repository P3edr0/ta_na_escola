<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Ta Na Escola</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>ta_na_escola</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	
	<!-- 1. PERMISSÃO DE CÂMERA (OBRIGATÓRIA) -->
	<key>NSCameraUsageDescription</key>
	<string>O Ta Na Escola usa a câmera para cadastrar o rosto dos pais e responsáveis, permitindo acesso seguro e automatizado durante reuniões escolares. As imagens são usadas exclusivamente para reconhecimento facial na portaria da escola.</string>
	
	<!-- 2. PERMISSÃO DE GALERIA (para mlkit_face_detection) -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>O Ta Na Escola precisa acessar suas fotos para permitir que você selecione uma imagem para o cadastro facial ou foto de perfil. Suas fotos não são compartilhadas com terceiros.</string>
	
	<!-- 3. PERMISSÃO DE NOTIFICAÇÕES (para firebase_messaging) -->
	<key>NSUserNotificationUsageDescription</key>
	<string>O Ta Na Escola envia notificações para alertar sobre a chegada e saída dos seus filhos da escola, garantindo que você esteja sempre informado sobre a segurança deles.</string>
	
	<!-- 4. CONFIGURAÇÃO PARA NOTIFICAÇÕES EM SEGUNDO PLANO -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	
	<!-- 5. SCHEMES PARA ABRIR LINKS EXTERNOS (para url_launcher) -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>https</string>
		<string>http</string>
		<string>tel</string>
		<string>sms</string>
		<string>mailto</string>
	</array>
	
	<!-- 6. CONFIGURAÇÃO FIREBASE -->
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
	
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	
	<!-- 7. ORIENTAÇÕES SUPORTADAS -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	
	<!-- 8. IMPEDE execução em iPad -->
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer> <!-- Apenas iPhone (1=iPhone, 2=iPad) -->
	</array>

	<!-- 9. Desabilita multitasking do iPad -->
	<key>UIRequiresFullScreen</key>
	<true/>

	<!-- =============================================== -->
	<!-- 10. PERMISSÕES E JUSTIFICATIVAS PARA INTERNET (NOVO) -->
	<!-- =============================================== -->
	
	<!-- 10.1 Declaração de Segurança de Transporte (ATS) - OBRIGATÓRIA -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Configuração padrão e segura: permite apenas HTTPS -->
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<!-- Se você precisa fazer uma exceção para um domínio HTTP específico, 
		adicione um bloco NSExceptionDomain aqui. Exemplo:
		<key>NSExceptionDomains</key>
		<dict>
			<key>seuservidor.com</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
		-->
	</dict>
	
	<!-- 10.2 Justificativa do Uso da Rede - OBRIGATÓRIA -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>O Ta Na Escola precisa se conectar à internet para sincronizar os dados de chegada e saída dos alunos, enviar notificações em tempo real para os pais e processar o cadastro facial com segurança.</string>
	
	<!-- 10.3 Justificativa para Acesso a Serviços de Rede Local (Bonjour) - Opcional, mas boa prática -->
	<key>NSBonjourServices</key>
	<array/>
	<!-- Esta chave com array vazio é uma declaração explícita de que o app não usa serviços de rede local como Bonjour. -->

</dict>
</plist>